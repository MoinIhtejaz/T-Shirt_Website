# Contract version 5. Every environment variable the app reads.
# Copy to .env at the project root. Loaded by src/shared/config.ts only;
# no other module reads process.env directly.

# Port the API server listens on. The Vite dev server proxies /api and /uploads here.
PORT=3001

# "development" or "production". Production serves the built UI from dist/ui.
NODE_ENV=development

# SQLite database file. The directory is created if missing.
DATABASE_FILE=./data/saltline.db

# Directory for uploaded and seeded product images, served at /uploads.
UPLOAD_DIR=./uploads

# Admin session lifetime in hours.
SESSION_TTL_HOURS=12

# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Set only when running behind a reverse proxy that terminates TLS, so the login rate
# limiter sees real client IPs. Use the number of proxy hops (usually 1), or loopback,
# linklocal or uniquelocal. Leave empty or false when the app faces the internet directly.
TRUST_PROXY=false

# Set to true to run as a read-only showcase: every write to /api (login included) is
# refused. Always on for Vercel deployments, which have no persistent disk.
READ_ONLY=false

# Admin account created or updated by `npm run seed`. Only the seed script reads these.
# The password must be at least 12 characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-something-long
